{
  "name": "questa-launcher",
  "displayName": "Questa Launcher",
  "description": "Run Questa simulations on SystemVerilog files with priority ordering and conf.svconf support",
  "version": "1.8.0",
  "publisher": "bismillah",
  "repository": { "type": "git", "url": "https://github.com/bismillah/questa-launcher" },
  "categories": ["Other"],
  "activationEvents": [
    "onLanguage:systemverilog",
    "workspaceContains:**/*.sv",
    "workspaceContains:**/*.svconf"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "questaLauncher.run", "title": "▶ Run in Questa", "icon": "$(play)" },
      { "command": "questaLauncher.runGui", "title": "🖥 Open Questa GUI", "icon": "$(device-desktop)" },
      { "command": "questaLauncher.editConf", "title": "⚙ Edit conf.svconf", "icon": "$(settings-gear)" },
      { "command": "questaLauncher.setPriority", "title": "⇅ Set Compile Priority", "icon": "$(list-ordered)" },
      { "command": "questaLauncher.setLicense", "title": "🔑 Set License", "icon": "$(key)" },
      { "command": "questaLauncher.helpDocs", "title": "❓ VSQuestaLauncher Help", "icon": "$(question)" },
      { "command": "questaLauncher.helpDeps", "title": "📦 Dependency Resolver", "icon": "$(package)" }
    ],
    "menus": {
      "editor/title": [
        { "command": "questaLauncher.run",      "when": "resourceExtname == .sv", "group": "navigation@1" },
        { "command": "questaLauncher.runGui",   "when": "resourceExtname == .sv", "group": "navigation@2" },
        { "command": "questaLauncher.setLicense","when": "resourceExtname == .sv", "group": "navigation@3" },
        { "command": "questaLauncher.setPriority","when": "resourceExtname == .sv", "group": "navigation@4" },
        { "command": "questaLauncher.editConf", "when": "resourceExtname == .sv", "group": "navigation@5" },
        { "command": "questaLauncher.helpDocs", "when": "resourceExtname == .sv", "group": "navigation@6" },
        { "command": "questaLauncher.helpDeps", "when": "resourceExtname == .sv", "group": "navigation@7" },
        { "command": "questaLauncher.setLicense","when": "resourceFilename == conf.svconf", "group": "navigation@1" },
        { "command": "questaLauncher.editConf", "when": "resourceFilename == conf.svconf", "group": "navigation@2" },
        { "command": "questaLauncher.helpDocs", "when": "resourceFilename == conf.svconf", "group": "navigation@3" }
      ],
      "editor/title/run": [
        { "command": "questaLauncher.run",      "when": "resourceExtname == .sv", "group": "navigation@1" },
        { "command": "questaLauncher.runGui",   "when": "resourceExtname == .sv", "group": "navigation@2" },
        { "command": "questaLauncher.setLicense","when": "resourceExtname == .sv", "group": "navigation@3" },
        { "command": "questaLauncher.helpDocs", "when": "resourceExtname == .sv", "group": "navigation@4" },
        { "command": "questaLauncher.helpDeps", "when": "resourceExtname == .sv", "group": "navigation@5" }
      ],
      "explorer/context": [
        { "command": "questaLauncher.run", "when": "resourceExtname == .sv", "group": "questa@1" },
        { "command": "questaLauncher.setPriority", "when": "resourceExtname == .sv", "group": "questa@2" }
      ]
    },
    "languages": [
      { "id": "svconf", "aliases": ["SV Config", "svconf"], "extensions": [".svconf"], "configuration": "./language-configuration.json" }
    ],
    "grammars": [
      { "language": "svconf", "scopeName": "source.svconf", "path": "./syntaxes/svconf.tmLanguage.json" }
    ],
    "configuration": {
      "title": "Questa Launcher",
      "properties": {
        "questaLauncher.questaBin": {
          "type": "string",
          "default": "",
          "description": "Path to Questa bin directory (e.g. /home/user/altera/25.1std/questa_fse/linux_x86_64). Leave empty to auto-detect from PATH."
        },
        "questaLauncher.extraVlogArgs": {
          "type": "string",
          "default": "-reportprogress 300",
          "description": "Extra arguments passed to vlog"
        },
        "questaLauncher.licenseFile": {
          "type": "string",
          "default": "",
          "description": "LM_LICENSE_FILE — general FlexLM license file path or port@host. Overrides environment variable."
        },
        "questaLauncher.saltLicenseServer": {
          "type": "string",
          "default": "",
          "description": "SALT_LICENSE_SERVER — Questa FSE/Starter Edition license file path. E.g. /home/user/.licenses/questa_license.dat"
        },
        "questaLauncher.licenseServer": {
          "type": "string",
          "default": "",
          "description": "MGLS_LICENSE_FILE — Questa/Siemens license server. Format: port@host"
        },
        "questaLauncher.alteraLicenseFile": {
          "type": "string",
          "default": "",
          "description": "ALTERAD_LICENSE_FILE — Altera/Intel FPGA license path or port@host"
        },
        "questaLauncher.autoOpenGui": {
          "type": "boolean",
          "default": false,
          "description": "Open Questa GUI after successful compile"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
